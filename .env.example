# Supabase Client Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_STORAGE_BUCKET=freebbonize-files

# Supabase Server / Backend Configuration (Keep confidential!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
MAX_FILE_SIZE_BYTES=3145728

# Native Postgres Database URL (Migrations / Seeders)
DATABASE_URL=postgresql://postgres.user:password@aws-pooler.supabase.com:5432/postgres

# App URL
VITE_APP_URL=http://localhost:5173
